{
  "name": "tilt",
  "version": "1.0.10",
  "description": "Tilt: clips, blips and games",
  "main": "main.js",
  "author": "Tilt",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tilt.app",
    "productName": "Tilt",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "config.js",
      "build/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Tilt-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "copyright": "Copyright \u00a9 2026 Tilt",
    "portable": {
      "artifactName": "Tilt-Portable-${version}.${ext}"
    }
  }
}