{
  "rules": {
    "tilt": {
      "profiles": {
        ".read": "auth != null",
        "$uid": {
          ".write": "(auth != null && auth.uid == $uid && !root.child('tilt/bans/'+auth.uid).exists()) || (auth != null && auth.token.email == 'wow22113@gmail.com')"
        }
      },
      "follows": {
        ".read": "auth != null",
        "$uid": {
          ".write": "(auth != null && auth.uid == $uid && !root.child('tilt/bans/'+auth.uid).exists()) || (auth != null && auth.token.email == 'wow22113@gmail.com')"
        }
      },
      "posts": {
        ".read": "auth != null",
        "$uid": {
          ".write": "(auth != null && auth.uid == $uid && !root.child('tilt/bans/'+auth.uid).exists()) || (auth != null && auth.token.email == 'wow22113@gmail.com')"
        }
      },
      "dms": {
        "$sid": {
          ".read": "auth != null && auth.uid == $sid",
          ".write": "auth != null && auth.uid == $sid && !root.child('tilt/bans/'+auth.uid).exists()",
          "to": {
            "$rid": {
              ".read": "auth != null && auth.uid == $rid"
            }
          }
        }
      },
      "users": {
        ".read": "auth != null && auth.token.email == 'wow22113@gmail.com'",
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "(auth != null && auth.uid == $uid && !root.child('tilt/bans/'+auth.uid).exists()) || (auth != null && auth.token.email == 'wow22113@gmail.com')"
        }
      },
      "bans": {
        ".read": "auth != null && auth.token.email == 'wow22113@gmail.com'",
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.token.email == 'wow22113@gmail.com'"
        }
      },
      "ov": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'wow22113@gmail.com'"
      },
      "announce": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'wow22113@gmail.com'"
      },
      "media": {
        "$uid": {
          ".read": "auth != null",
          ".write": "(auth != null && auth.uid == $uid && !root.child('tilt/bans/'+auth.uid).exists()) || (auth != null && auth.token.email == 'wow22113@gmail.com')"
        }
      }
    }
  }
}